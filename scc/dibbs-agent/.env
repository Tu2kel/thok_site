NAVIGATOR_PASSWORD=052505

# ── FSC LANES TO MONITOR ──────────────────────────────────────────────
# FIX [2]: Expanded from 10 → 24 lanes.
# Added: 5340, 4720, 4810, 4820, 2920, 2940, 3110, 3120, 6230, 9505, 9520, 9535, 8140, 8145
