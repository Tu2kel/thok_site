# Exclude Restricted/AIDC (recommended: true until JCP cert is live)
NAVIGATOR_EXCLUDE_RESTRICTED=true
NAVIGATOR_EXCLUDE_AIDC=true
NAVIGATOR_EXCLUDE_JCP_UNKNOWN=false

# Date Offset (days back from today; 0=today, 180=LHF window)
