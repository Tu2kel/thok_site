# ── DIBBS Navigator ──────────────────────────────────────────────────────
NAVIGATOR_USERNAME=your_dibbsnavigator_username
NAVIGATOR_PASSWORD=your_dibbsnavigator_password
# Comma-separated FSC lanes to scrape each day
NAVIGATOR_FSC_LANES=5305,5306,5310,5315,5320,5340,5360,4730,4940,2540
# Min extended price — sols below this are skipped
NAVIGATOR_MIN_EXT_PRICE=1000

# ── Claude / Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://...

# ── Gmail OAuth2 (Google Workspace — anthony@ifedlog.com) ────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ── Schedule ─────────────────────────────────────────────────────────────
# Cron expression — default 6:00 AM CT (12:00 UTC)
CRON_SCHEDULE=0 12 * * 1-5

# ── Blast config ─────────────────────────────────────────────────────────
# Max vendors emailed per FSC lane
BLAST_CAP_PER_FSC=3

# ── Notifications ────────────────────────────────────────────────────────
SUMMARY_EMAIL=anthony@ifedlog.com
